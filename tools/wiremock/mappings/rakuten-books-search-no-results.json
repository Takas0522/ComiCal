{
  "_comment": "Sentinel keyword __NORESULTS__ returns an empty result set. Used to exercise the Rakuten client's empty-page handling.",
  "priority": 3,
  "request": {
    "method": "GET",
    "urlPathPattern": "/services/api/BooksTotal/Search/20170404",
    "queryParameters": {
      "keyword": { "equalTo": "__NORESULTS__" }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json; charset=utf-8"
    },
    "jsonBody": {
      "GenreInformation": [],
      "Items": [],
      "count": 0,
      "page": 1,
      "first": 0,
      "last": 0,
      "hits": 0,
      "carrier": 0,
      "pageCount": 0
    }
  }
}
