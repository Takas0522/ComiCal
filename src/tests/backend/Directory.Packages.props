<Project>
  <ItemGroup>
    <!-- xUnit v3 + Microsoft Testing Platform -->
    <PackageVersion Include="xunit.v3" Version="3.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />

    <!-- Assertions / mocks -->
    <PackageVersion Include="FluentAssertions" Version="7.2.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />

    <!-- Coverage -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />

    <!-- TimeProvider testing -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />

    <!-- Integration -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageVersion Include="Testcontainers" Version="4.7.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.7.0" />
    <PackageVersion Include="Testcontainers.Azurite" Version="4.7.0" />
    <PackageVersion Include="Microsoft.SqlServer.DacFx" Version="162.5.57" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.1" />

    <!-- HTTP stubbing for Rakuten Books API integration tests -->
    <PackageVersion Include="WireMock.Net" Version="2.4.0" />
  </ItemGroup>
</Project>
