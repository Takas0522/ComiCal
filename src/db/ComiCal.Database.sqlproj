<Project Sdk="Microsoft.Build.Sql/2.1.0">
  <PropertyGroup>
    <Name>ComiCal.Database</Name>
    <RootNamespace>ComiCal.Database</RootNamespace>
    <AssemblyName>ComiCal.Database</AssemblyName>
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>
    <ModelCollation>1041, CS</ModelCollation>
    <SqlServerVerification>True</SqlServerVerification>
    <ValidateCasingOnIdentifiers>False</ValidateCasingOnIdentifiers>
    <TreatTSqlWarningsAsErrors>False</TreatTSqlWarningsAsErrors>
    <SuppressTSqlWarnings>71502</SuppressTSqlWarnings>
    <ProjectGuid>{00000000-0000-0000-0000-000000000000}</ProjectGuid>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exclude scripts and publish profiles from the schema model build -->
    <Build Remove="Scripts\**\*.sql" />
    <Build Remove="publish-profiles\**" />
    <None Include="Scripts\PreDeploy\**\*.sql" />
    <None Include="Scripts\PostDeploy\**\*.sql" />
    <None Include="Scripts\Seed\**\*.sql" />
    <None Include="publish-profiles\**" />
    <PreDeploy Include="Scripts\PreDeploy.sql" />
    <PostDeploy Include="Scripts\PostDeploy.sql" />
  </ItemGroup>
  <ItemGroup>
    <SqlCmdVariable Include="SeedDev">
      <DefaultValue>0</DefaultValue>
      <Value>$(SqlCmdVar__SeedDev)</Value>
    </SqlCmdVariable>
    <SqlCmdVariable Include="AdminDisplayName">
      <DefaultValue>ComiCal Admin</DefaultValue>
      <Value>$(SqlCmdVar__AdminDisplayName)</Value>
    </SqlCmdVariable>
  </ItemGroup>
</Project>