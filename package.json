{
  "name": "comical",
  "version": "0.0.0",
  "private": true,
  "description": "まんがリマインダー — 漫画発売予定一元管理 Web アプリ",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "install:all": "pnpm install && dotnet restore src/backend/ComiCal.slnx",
    "build": "pnpm run build:db && pnpm run build:backend && pnpm --filter frontend build",
    "build:db": "dotnet build src/db/ComiCal.Database.sqlproj",
    "build:backend": "dotnet build src/backend/ComiCal.slnx",
    "build:frontend": "pnpm --filter frontend build",
    "test": "pnpm run test:frontend && pnpm run test:backend",
    "test:frontend": "pnpm --filter frontend test",
    "test:backend": "dotnet test src/backend/ComiCal.slnx --no-build",
    "test:e2e": "pnpm --filter e2e test",
    "lint": "pnpm run lint:frontend && pnpm run lint:backend",
    "lint:frontend": "pnpm --filter frontend lint",
    "lint:backend": "dotnet format src/backend/ComiCal.slnx --verify-no-changes",
    "format": "pnpm --filter frontend format && dotnet format src/backend/ComiCal.slnx"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^19.0.0",
    "@cyclonedx/cyclonedx-npm": "^4.2.1",
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-playwright": "^2.0.0",
    "prettier": "^3.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "pnpm": {
    "overrides": {
      "uuid@<14.0.0": "^14.0.0",
      "libxmljs2": "-",
      "js-yaml@<3.14.2": "^3.14.2"
    },
    "ignoredOptionalDependencies": [
      "libxmljs2"
    ]
  }
}
