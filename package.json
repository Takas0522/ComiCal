{
  "name": "comical-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "ComiCal (まんがリマインダー) — monorepo root scripts",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "format": "pnpm -r --if-present format",
    "fe:dev": "pnpm --filter frontend dev",
    "fe:build": "pnpm --filter frontend build",
    "fe:test": "pnpm --filter frontend test",
    "e2e": "pnpm --filter e2e test",
    "be:build": "dotnet build src/backend/ComiCal.sln",
    "be:test": "dotnet test src/backend/ComiCal.sln",
    "be:format": "dotnet format src/backend/ComiCal.sln",
    "db:build": "dotnet build src/db/ComiCal.Database.sqlproj",
    "infra:build": "bicep build infra/main.bicep"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^2.0.0"
  }
}
